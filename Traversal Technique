class Solution {
  public:
  void dfs(int node, vector<vector<int>>adj, vector<int>& visited, vector<int>& ans){
    visited[node]=1;
    ans.push_back(node);

    for(int neighbour:adj[node]){
        if(!visited[neighbour]){
             dfs(neighbour,adj,visited,ans);
        }
    }
  }
    vector<int> dfsOfGraph(int V, vector<vector<int>> edges) {
        vector<vector<int>>adj(V);
        for(auto edge:edges){
            int u=edge[0];
            int v=edge[1];
            adj[u].push_back(v);
            adj[v].push_back(u);
        }
        vector<int>visited(V,0);
        vector<int>ans;
        dfs(0,adj,visited,ans);

        return ans;
        
     
    }
    
    vector<int> bfsOfGraph(int V, vector<vector<int>> edges) {
        vector<vector<int>> adj(V);

        for(auto edge:edges){
            int u=edge[0];
            int v=edge[1];
            adj[u].push_back(v);
            adj[v].push_back(u);
        }
        vector<int>ans;
        vector<int>visited(V,0);
            // start from bfs 0
        visited[0]=1;
        queue<int>q;
        q.push(0);

        while(!q.empty()){
            int node=q.front();
            q.pop();

            ans.push_back(node);

            for(int neighbour:adj[node]){
                if(!visited[neighbour]){
                    visited[neighbour]=1;

                        q.push(neighbour);
                }
            }
        }
        return ans;
    }
};
