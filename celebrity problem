class Solution
{
public:
    int celebrity(vector<vector<int>> &M){
       int n=M.size();
     
       // everybody knows celebrity
       for(int i=0;i<n;i++){
          bool celeb=true;
        for(int j=0;j<n;j++){
            if(M[i][j]==1){
            celeb=false;
            break;  
            }
        }
        // celebrity knows nobody
        if(celeb){
            for(int j=0;j<n;j++){
                if(i!=j && M[j][i]==0){  // here M[j][i] ayaga as j doennot know nobody
                celeb=false;
                break;
                }
            }
        }
         if(celeb)
       return i;
       }
       return -1;
    }
};
